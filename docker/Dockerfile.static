# syntax=docker/dockerfile:1
FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate
RUN npm install --global turbo@2.10.10
WORKDIR /repo

# `turbo prune` computes the workspace-dependency subgraph for this app from
# turbo.json + the lockfile, so new packages/layers don't need a Dockerfile edit.
FROM base AS pruner
ARG PACKAGE
COPY . .
RUN turbo prune ${PACKAGE} --docker

FROM base AS build
ARG PACKAGE
ARG NUXT_PUBLIC_APP_URL=http://localhost:3000
ENV NUXT_PUBLIC_APP_URL=$NUXT_PUBLIC_APP_URL
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ .
RUN pnpm --filter ${PACKAGE} build

FROM nginx:1.31-alpine
ARG APP_DIR
COPY --from=build /repo/${APP_DIR}/.output/public /usr/share/nginx/html
COPY docker/nginx-web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
