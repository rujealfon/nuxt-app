{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleDetection": "force",
    "module": "preserve",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node", "nuxt"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "test/**/*.ts",
    "packages/config/**/*.ts",
    "packages/types/**/*.ts",
    "packages/logger/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/.nuxt",
    "**/dist"
  ]
}
