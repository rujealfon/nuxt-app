{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@nuxt-app/api",
    "dev:app": "turbo run dev --filter=@nuxt-app/app",
    "dev:admin": "turbo run dev --filter=@nuxt-app/admin",
    "dev:site": "turbo run dev --filter=@nuxt-app/site",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @nuxt-app/db generate",
    "db:migrate": "pnpm --filter @nuxt-app/db migrate",
    "db:studio": "pnpm --filter @nuxt-app/db studio",
    "db:seed": "pnpm --filter @nuxt-app/api db:seed",
    "predocker:up": "bash scripts/ensure-docker-env.sh",
    "predocker:rebuild": "bash scripts/ensure-docker-env.sh",
    "predocker:reset": "bash scripts/ensure-docker-env.sh",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:start": "docker compose start",
    "docker:stop": "docker compose stop",
    "docker:restart": "docker compose restart",
    "docker:rebuild": "docker compose up --build -d --wait",
    "docker:reset": "docker compose down -v && docker compose up --build -d --wait",
    "docker:db:migrate": "docker compose exec api pnpm --filter @nuxt-app/db migrate",
    "docker:db:seed": "docker compose exec api pnpm db:seed"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3"
  }
}
