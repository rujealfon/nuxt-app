{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.23.2 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @nuxt-app/web dev",
    "dev:app": "pnpm --filter @nuxt-app/app dev",
    "dev:admin": "pnpm --filter @nuxt-app/admin dev",
    "dev:api": "pnpm --filter @nuxt-app/api dev",
    "dev": "turbo run dev",
    "dev:stop": "node scripts/stop-dev.mjs",
    "db:up": "docker compose up -d --wait --remove-orphans",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:studio:docker": "docker compose up -d --build --wait drizzle-studio && echo 'Drizzle Studio -> https://local.drizzle.studio?port=4984'",
    "db:reset": "docker compose down -v && docker compose up -d --build --wait --remove-orphans",
    "db:generate": "pnpm --filter @nuxt-app/api db:generate",
    "db:migrate": "pnpm --filter @nuxt-app/api db:migrate",
    "db:push": "pnpm --filter @nuxt-app/api db:push",
    "db:studio": "pnpm --filter @nuxt-app/api db:studio",
    "db:seed": "pnpm --filter @nuxt-app/api db:seed",
    "db:auth:generate": "pnpm --filter @nuxt-app/api db:auth:generate",
    "build": "turbo run build",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --project unit --project client --project ui --project web --project app --project admin",
    "type-check": "turbo run type-check && tsc -p tsconfig.test.json",
    "vite-doctor": "turbo run vite-doctor --continue",
    "clean": "turbo run clean",
    "postinstall": "turbo run nuxt:prepare",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@nuxt/test-utils": "^4.3.2",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.8",
    "prettier-plugin-css-order": "^2.2.0",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "lint-staged": {
    "*": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js --fix --no-warn-ignored"
  }
}
