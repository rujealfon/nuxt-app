{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@nuxt-app/api",
    "dev:app": "turbo run dev --filter=@nuxt-app/app",
    "dev:admin": "turbo run dev --filter=@nuxt-app/admin",
    "dev:site": "turbo run dev --filter=@nuxt-app/site",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @nuxt-app/db generate",
    "db:migrate": "pnpm --filter @nuxt-app/db migrate",
    "db:studio": "pnpm --filter @nuxt-app/db studio",
    "db:seed": "pnpm --filter @nuxt-app/api db:seed"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3"
  }
}
