# app.nuxt-app.com
NUXT_PUBLIC_API_BASE=https://api.nuxt-app.com
# Optional product API version (defaults to the current one from @nuxt-app/config).
# NUXT_PUBLIC_API_VERSION=v1
# Session transport. Leave unset for cookies; set to `bearer` inside a native
# shell (Capacitor), where the WebView rejects the API's cross-origin cookie.
# NUXT_PUBLIC_AUTH_MODE=bearer
NUXT_PUBLIC_WEB_URL=https://web.nuxt-app.com
NUXT_PUBLIC_APP_URL=https://app.nuxt-app.com
NUXT_PUBLIC_ADMIN_URL=https://admin.nuxt-app.com
