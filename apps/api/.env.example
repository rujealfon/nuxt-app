# api.nuxt-app.com

# --- Local dev (Docker: docker-compose.yml) ---
DATABASE_URL=postgres://nuxt_app_user:nuxt_app_password@localhost:55432/nuxt_app_db
# Redis backs Better Auth rate limiting (not sessions).
REDIS_URL=redis://localhost:6381
# Set to false to disable the API's own rate limiter (e.g. load tests or tests).
# RATE_LIMIT_ENABLED=true
# Scalar API docs (`/api/docs`, `/api/openapi.json`) are development-only.
# Set to true to expose them from a production build (contract tests do this).
# DOCS_ENABLED=true
BETTER_AUTH_URL=http://localhost:3003
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional pino log level (trace|debug|info|warn|error|fatal). Defaults to
# debug in development and info in production. Logs pretty-print outside
# production and emit structured JSON in production.
# LOG_LEVEL=debug

# Seed user created by `pnpm --filter @nuxt-app/api db:seed`
SEED_EMAIL=dev@nuxt-app.com
SEED_PASSWORD=password123

# --- Production (Vercel) ---
# Neon Postgres (use the pooled connection string). DATABASE_DRIVER=neon|pg
# wins when set; otherwise a *.neon.tech hostname selects neon-http.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_DRIVER=neon
# BETTER_AUTH_URL=https://api.nuxt-app.com
# BETTER_AUTH_SECRET=
# Redis over TCP. Managed providers expose a TLS URL (rediss://).
# REDIS_URL=rediss://default:password@host:port

# Comma-separated list of allowed CORS + Better Auth trusted origins. Use * to allow all.
CORS_ORIGINS=https://web.nuxt-app.com,https://app.nuxt-app.com,https://admin.nuxt-app.com
