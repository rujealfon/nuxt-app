# api.mysite.com

# --- Local dev (Docker: docker-compose.yml) ---
DATABASE_URL=postgres://nuxt_app_user:nuxt_app_password@localhost:55432/nuxt_app_db
REDIS_URL=redis://localhost:6381

# Seed user created by `pnpm --filter @mysite/api db:seed`
SEED_EMAIL=dev@mysite.com
SEED_PASSWORD=password123

# --- Production (Vercel) ---
# Neon Postgres (use the pooled connection string). DATABASE_DRIVER=neon is
# inferred from a *.neon.tech host, but can be set explicitly.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_DRIVER=neon
# Redis over TCP. Managed providers expose a TLS URL (rediss://).
# REDIS_URL=rediss://default:password@host:port

# Comma-separated list of allowed CORS origins. Use * to allow all.
CORS_ORIGINS=https://web.mysite.com,https://app.mysite.com,https://admin.mysite.com
