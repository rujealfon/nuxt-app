{
  "name": "@nuxt-app/api",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
