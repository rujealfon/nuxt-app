# Shared reference for the mysite monorepo.
# Each app reads its own .env — copy the per-app examples:
#   apps/web/.env.example
#   apps/app/.env.example
#   apps/admin/.env.example
#   apps/api/.env.example

# --- apps/api (local dev) ---
DATABASE_URL=postgres://nuxt_app_user:nuxt_app_password@localhost:55432/nuxt_app_db
REDIS_URL=redis://localhost:6381
CORS_ORIGINS=https://web.mysite.com,https://app.mysite.com,https://admin.mysite.com

# --- apps/api (production / Vercel) ---
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_DRIVER=neon
# REDIS_URL=rediss://default:password@host:port
