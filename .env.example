# Shared
NODE_ENV=development

# API
API_PORT=3001
API_HOST=0.0.0.0
API_URL=http://localhost:3001
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_DOMAIN=localhost

# Database (Postgres)
POSTGRES_USER=nuxt
POSTGRES_PASSWORD=nuxt
POSTGRES_DB=nuxt_app
# Host apps: localhost:5432 if Postgres is local, or localhost:5433 if using Compose
DATABASE_URL=postgres://nuxt:nuxt@localhost:5432/nuxt_app
# Optional. Defaults to the same host/user as DATABASE_URL with database nuxt_app_test
DATABASE_URL_TEST=postgres://nuxt:nuxt@localhost:5432/nuxt_app_test

# Redis via @upstash/redis (HTTP). Local Compose: SRH on 8079 in front of Redis.
# Production: set these to your Upstash REST URL and token.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Frontends (for CORS + redirects)
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
WEB_URL=http://localhost:3003
NUXT_PUBLIC_API_URL=http://localhost:3001
